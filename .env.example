# Plantilla sin secretos. Cópiala como .env y rellénala; .env nunca se sube a git ni va en el paquete.

# Modelo
OPENAI_API_KEY=

# Meta / WhatsApp. Usa un token de usuario del sistema: los temporales caducan en horas.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0

# Únicos números a los que el bot responde: dígitos internacionales sin +, separados por comas.
WHATSAPP_ALLOWED_NUMBERS=

# SQL Server: usa una cuenta de solo lectura (scripts/sql/dbagg_readonly.sql).
DB_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=servidor,1433;DATABASE=base;UID=usuario;PWD=clave;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly;
SQL_ALLOWED_TABLES=
# Solo si el servidor no tiene un certificado verificable; también requiere TrustServerCertificate=yes.
# DB_ALLOW_UNVERIFIED_TLS=true

# Para dbagg-report, si no usa DB_CONNECTION_STRING
# DB_SERVER=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Opcionales
FEEDBACK_ENABLED=false
GAP_LOG_ENABLED=false
# BUSINESS_TIMEZONE=America/Mexico_City
# DATA_RETENTION_DAYS=90

# Cloudflare Tunnel: token del conector
CLOUDFLARE_TUNNEL_TOKEN=
