# Copy these names into your local .env. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
# Set to a Graph API version supported by your Meta application, e.g. v23.0.
META_GRAPH_VERSION=
# International digits only, separated by commas (no +, spaces or dashes).
WHATSAPP_ALLOWED_NUMBERS=
# Explicit schema.object allowlist. Prefer dedicated views with only approved columns.
SQL_ALLOWED_TABLES=
# Complete ODBC connection string; Encrypt=yes;TrustServerCertificate=no.
# A SQL account with SELECT permissions ONLY on the allowlisted views is required.
DB_CONNECTION_STRING=
