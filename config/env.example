# Copy names into the repository-root .env; never overwrite existing credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
WHATSAPP_ALLOWED_NUMBERS=
SQL_ALLOWED_TABLES=proadel.CATALOGO_CLIENTES_DATA_V,proadel.COBRANZA_DATA
DB_CONNECTION_STRING=
DB_ALLOW_UNVERIFIED_TLS=false
# Explicit opt-in: votes store the question, answer and recent history LOCALLY.
# They can contain financial information. No sender phone metadata is persisted.
FEEDBACK_ENABLED=false
# Optional directory containing .env, config/ and data/ when running outside checkout:
# DBAGG_HOME=C:/path/to/dbagg
